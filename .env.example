# -----------------------------------------------------------------------------
# Já — Gestão de Equipes e Pagamentos
# Arquivo de exemplo de variáveis de ambiente (.env.example)
# NUNCA inclua credenciais reais ou chaves de produção neste arquivo.
# -----------------------------------------------------------------------------

# Supabase — Banco de dados, Autenticação e RLS
SUPABASE_PROJECT_ID="your-project-id"
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."

# Supabase — Variáveis consumidas pelo Vite no navegador
VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Asaas — Integração Financeira Pix (Sandbox por padrão)
ASAAS_API_KEY="$aact_..."
ASAAS_AMBIENTE="sandbox"
ASAAS_WEBHOOK_TOKEN="token-webhook-asaas"

# Mercado Pago — Cobrança de Faturas SaaS
MERCADOPAGO_ACCESS_TOKEN="TEST-..."
MERCADOPAGO_WEBHOOK_SECRET="secret-webhook-mp"